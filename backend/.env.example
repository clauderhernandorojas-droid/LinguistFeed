# --- OpenRouter (producción / cuando publiques) ---
OPENROUTER_API_KEY=

# --- LM Studio (reader: traducción palabras / flashcards en /api/articles/analyze-text) ---
# Deja LM Studio en Local Server → http://127.0.0.1:1234 y el modelo cargado.
USE_LMSTUDIO_FOR_ANALYZE=true
LMSTUDIO_CHAT_URL=http://127.0.0.1:1234/v1/chat/completions
LMSTUDIO_MODEL=qwen2.5-3b-instruct

# --- Quiz sin gastar créditos hasta publicación ---
MOCK_READER_QUIZ=true
MOCK_SCHEDULER_QUIZ=true
