# --- OpenRouter (producción / cuando publiques) ---
OPENROUTER_API_KEY=

# --- LM Studio (reader: traducción palabras / flashcards en /api/articles/analyze-text) ---
# Deja LM Studio en Local Server → http://127.0.0.1:1234 y el modelo cargado.
USE_LMSTUDIO_FOR_ANALYZE=true
LMSTUDIO_CHAT_URL=http://127.0.0.1:1234/v1/chat/completions
LMSTUDIO_MODEL=qwen2.5-3b-instruct

# --- Generación por nivel CEFR (batch: npm run batch-simplify) ---
# Si es true, generateLeveledArticle usa LM Studio (textos largos: sube LMSTUDIO_LEVELING_MAX_TOKENS si corta).
USE_LMSTUDIO_FOR_LEVELING=true
LMSTUDIO_LEVELING_MAX_TOKENS=8192
LMSTUDIO_LEVELING_TIMEOUT_MS=180000
# BATCH_SIMPLIFY_TOP=10
# BATCH_SIMPLIFY_LEVELS=A1,A2,B1,B2,C1,C2
# BATCH_SIMPLIFY_DELAY_MS=800
# BATCH_SIMPLIFY_FORCE=false

# --- Quiz sin gastar créditos hasta publicación ---
MOCK_READER_QUIZ=true
MOCK_SCHEDULER_QUIZ=true

# --- Migración artículos a SQLite ---
# Activa fallback de lectura a JSON solo para emergencia.
READ_JSON_FALLBACK=false
# Durante transición puedes mantener JSON como respaldo de escritura.
DUAL_WRITE_JSON=true

# --- CORS para frontend público (separar por comas) ---
# Ejemplo:
# CORS_ORIGINS=https://clauderhernandorojas-droid.github.io,https://tu-otro-dominio.com
CORS_ORIGINS=
